// What every other module talks about: a schema, the values a row holds once
// it is typed, and what can be wrong with them.

import "std/strings"

// One cell, typed by its column. A cell that was empty, null or absent is Missing.
pub type Value = IntV(long) | FloatV(float) | Text(string) | Flag(bool) | Missing

pub struct Column {
    name: string,
    kind: string,            // int | float | string | bool | date
    required: bool,
    hasMin: bool,
    min: float,
    hasMax: bool,
    max: float,
    allowed: Array<string>   // empty: any value
}

pub struct Schema {
    name: string,
    columns: Array<Column>,
    rejectUnknown: bool
}

// A row that passed every check. `place` names it in messages: "line 4" for
// CSV, "record 3" for JSON.
pub struct Record {
    row: int,
    place: string,
    cells: Map<string, Value>
}

pub struct Problem {
    row: int,                // where it is in the file: a line or record number, 0 for the file itself
    place: string,
    column: string,          // "" when the problem is not one column's
    message: string
}

pub fn isKind(s: string) -> bool {
    s == "int" || s == "float" || s == "string" || s == "bool" || s == "date"
}

pub fn isNumeric(c: Column) -> bool {
    c.kind == "int" || c.kind == "float"
}

pub fn column(s: Schema, name: string) -> Option<Column> {
    for c in s.columns { if c.name == name { return Some(c) } }
    None
}

pub type Option<T> = Some(T) | None

// A value as text, the way it is written back to CSV and shown in reports.
pub fn text(v: Value) -> string {
    match v {
        IntV(n) => toString(n),
        FloatV(x) => plain(x),
        Text(s) => s,
        Flag(b) => if b { "true" } else { "false" },
        Missing => ""
    }
}

// The shortest decimal that reads back as x, never in exponent form:
// 1e20 is 100000000000000000000.0 and 0.1 is 0.1.
pub fn plain(x: float) -> string {
    imut full = strings.formatFloat(x, 17)
    if !contains(full, ".") { return full }
    mut end = len(full)
    while end > 0 && substring(full, end - 1, end) == "0" { end -= 1 }
    if substring(full, end - 1, end) == "." { end += 1 }
    substring(full, 0, end)
}

// A number as a float, for sums and means; null-free since Missing is skipped by callers.
pub fn number(v: Value) -> float {
    match v {
        IntV(n) => n * 1.0,      // toFloat takes only an int (PAIN_POINTS D-toFloat)
        FloatV(x) => x,
        _ => 0.0
    }
}

pub fn isMissing(v: Value) -> bool {
    match v {
        Missing => true,
        _ => false
    }
}

// Orders two values of one column: numbers by value, text and dates as text,
// false before true, and Missing after everything.
pub fn compare(a: Value, b: Value) -> int {
    if isMissing(a) || isMissing(b) {
        if isMissing(a) && isMissing(b) { return 0 }
        return if isMissing(a) { 1 } else { -1 }
    }
    match a {
        IntV(x) => match b {
            IntV(y) => if x < y { -1 } else if x > y { 1 } else { 0 },
            _ => sign(number(a) - number(b))
        },
        FloatV(x) => sign(x - number(b)),
        Text(s) => compareText(s, text(b)),
        Flag(p) => compareText(text(a), text(b)),
        Missing => 0
    }
}

fn sign(d: float) -> int {
    if d < 0 { -1 } else if d > 0 { 1 } else { 0 }
}

pub fn compareText(a: string, b: string) -> int {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}

fn hex4(n: int) -> string {
    imut digits = "0123456789abcdef"
    mut out = ""
    mut rest = n
    for mut i = 0 i < 4 i = i + 1 {
        out = substring(digits, rest % 16, rest % 16 + 1) + out
        rest = rest / 16
    }
    out
}

// Text comes from a file, and a terminal obeys control sequences and reorders
// text around bidirectional controls, so a text report shows C0 and C1
// controls and the bidirectional overrides and isolates as escapes.
pub fn safe(s: string) -> string {
    imut out = strings.builder()
    for c in strings.chars(s) {
        imut code = ord(c)
        if code < 32 || (code >= 127 && code < 160) || (code >= 8234 && code <= 8238)
            || (code >= 8294 && code <= 8297) || code == 8206 || code == 8207 {
            out.append("\\u" + hex4(code))
        } else {
            out.append(c)
        }
    }
    toString(out)
}
