import "std/testing"
import "model"
import "query"
import "helpers"

imut DATA = "id,dept,pay,start,remote\n1,eng,10,2024-01-01,true\n2,ops,,2023-05-05,false\n3,eng,30,,true\n4,,20,2024-01-01,\n"

fn conditionOf(text: string) -> Condition {
    match query.condition(helpers.staff(), text) {
        Good(c) => { return c },
        Bad(why) => { throw why }
    }
}

fn rejection(text: string) -> string {
    match query.condition(helpers.staff(), text) {
        Good(c) => "accepted",
        Bad(why) => why
    }
}

fn ids(text: string) -> string {
    imut c = helpers.csvOf(helpers.staff(), DATA)
    helpers.column(query.filter(c.records, [conditionOf(text)]), "id")
}

fn equalityComparesTypedValues() {
    testing.assertEq(ids("dept=eng"), "1,3", "text")
    testing.assertEq(ids("pay=10.0"), "1", "10.0 is 10")
    testing.assertEq(ids("remote=false"), "2", "bool")
    testing.assertEq(ids("dept="), "4", "an empty value matches missing")
    testing.assertEq(ids("dept!="), "1,2,3", "and != missing")
    testing.assertEq(ids("dept!=eng"), "2,4", "missing is not eng")
}

fn orderingSkipsMissingValues() {
    testing.assertEq(ids("pay>10"), "3,4", "greater")
    testing.assertEq(ids("pay<=20"), "1,4", "missing is not less")
    testing.assertEq(ids("start>=2024-01-01"), "1,4", "dates")
    testing.assertEq(ids("id<3"), "1,2", "ints")
}

fn theFirstOperatorDecides() {
    imut c = conditionOf("dept=a>b")
    testing.assertEq(c.op + " " + model.text(c.value), "= a>b", "the value may hold an operator")
    imut d = conditionOf("pay>=-1.5")
    testing.assertEq(d.op + " " + model.text(d.value), ">= -1.5", "two-character operators")
}

fn badConditionsSayWhy() {
    testing.assertEq(rejection("nope=1"), "--where names a column the schema does not have: \"nope\"", "column")
    testing.assertEq(rejection("pay>x"), "--where pay>x: not a number", "number")
    testing.assertEq(rejection("id=1.5"), "--where id=1.5: not an integer", "integer")
    testing.assertEq(rejection("start=2024-02-30"), "--where start=2024-02-30: not a date written YYYY-MM-DD", "date")
    testing.assertEq(rejection("remote<true"), "--where remote<true: cannot order true and false", "bool")
    testing.assertEq(rejection("pay>"), "--where pay>: cannot order a missing value", "missing")
    testing.assertEq(rejection("=1"), "--where needs COLUMN=VALUE, or one of != >= <= > <, got \"=1\"", "no column")
}

fn orderPutsMissingLastBothWays() {
    imut c = helpers.csvOf(helpers.staff(), DATA)
    imut pay = conditionOf("pay=1").column
    testing.assertEq(helpers.column(query.order(c.records, pay, false), "id"), "1,4,3,2", "ascending")
    testing.assertEq(helpers.column(query.order(c.records, pay, true), "id"), "3,4,1,2", "descending")
    imut start = conditionOf("start=").column
    testing.assertEq(helpers.column(query.order(c.records, start, false), "id"), "2,1,4,3", "ties keep file order")
}

fn main() {
    testing.run("query", [equalityComparesTypedValues, orderingSkipsMissingValues, theFirstOperatorDecides,
                          badConditionsSayWhy, orderPutsMissingLastBothWays])
}
