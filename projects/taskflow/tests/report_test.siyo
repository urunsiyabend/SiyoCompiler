import "std/testing"
import "std/json"
import "model"
import "graph"
import "report"
import "status"
import "helpers"

fn controlCharactersBecomeEscapes() {
    testing.assertEq(report.safe("a" + chr(27) + "[31m"), "a\\u001b[31m", "ESC")
    testing.assertEq(report.safe(chr(10)), "\\u000a", "newline")
    testing.assertEq(report.safe(chr(127) + chr(155)), "\\u007f\\u009b", "DEL and C1")
}

fn ordinaryTextIsLeftAlone() {
    testing.assertEq(report.safe("café <b> 😀"), "café <b> 😀", "kept")
}

fn validateCountsWithProperWords() {
    imut one = helpers.project("[{\"id\": \"a\"}]")
    testing.assertEq(report.validateText(one, []), "ok: 1 task, 0 dependencies\n", "one task")
    imut two = helpers.project("[{\"id\": \"a\", \"deps\": [\"b\"]}, {\"id\": \"b\"}]")
    testing.assertEq(report.validateText(two, []), "ok: 2 tasks, 1 dependency\n", "plural")
}

fn validateJsonIsParseableAndSaysWhy() {
    imut p = helpers.project("[{\"id\": \"a\", \"dep\": 1}]")
    match json.parse(report.validateJson(p, [["a", "a"]])) {
        Parsed(m) => {
            testing.assertEq(toString(m["valid"]), "false", "invalid")
            testing.assertEq(toString(m["cycles"]), "[[a, a]]", "cycles")
            testing.assertEq(toString(m["problems"]), "[{place: t.json: tasks[0], problem: unknown field \"dep\"}]", "problems")
        },
        Invalid(why) => testing.assert(false, why)
    }
}

fn statusCountsAndWarns() {
    imut p = helpers.project("[{\"id\": \"a\", \"status\": \"done\", \"estimate\": 2, \"deps\": [\"b\"]}, {\"id\": \"b\", \"estimate\": 3}, {\"id\": \"c\", \"status\": \"doing\", \"deps\": [\"b\"]}]")
    imut s = status.compute(p, graph.build(p.tasks))
    testing.assertEq(toString(s.percentDone), "33", "rounds down")
    testing.assertEq(toString(s.hoursDone), "2", "done")
    testing.assertEq(toString(s.hoursLeft), "4", "left")
    testing.assertEq(toString(s.warnings), "[a is done but needs b, which is todo, c is running but needs b, which is todo]", "warnings")
    testing.assertEq(s.ready[0].id, "b", "ready")
    testing.assertEq(toString(len(s.ready)), "1", "only b")
}

fn anEmptyProjectIsComplete() {
    imut p = helpers.project("[]")
    imut s = status.compute(p, graph.build(p.tasks))
    testing.assertEq(toString(s.percentDone), "100", "nothing to do")
}

fn main() {
    testing.run("report", [controlCharactersBecomeEscapes, ordinaryTextIsLeftAlone, validateCountsWithProperWords,
        validateJsonIsParseableAndSaysWhy, statusCountsAndWarns, anEmptyProjectIsComplete])
}
