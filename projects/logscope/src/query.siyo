// Which records a run looks at.

import "cli"
import "record"

pub struct Filter {
    levels: string[],
    service: string,
    since: string,
    until: string,
    grep: string
}

pub fn fromOptions(o: Options) -> Filter {
    Filter { levels: o.levels, service: o.service, since: o.since, until: o.until, grep: o.grep }
}

fn levelAllowed(levels: string[], level: string) -> bool {
    if len(levels) == 0 { return true }
    for l in levels { if l == level { return true } }
    false
}

// Timestamps are ISO-8601 in UTC, so comparing them as strings orders them.
// since is inclusive and until exclusive; a record without a timestamp fails
// any time filter rather than silently passing it.
fn inWindow(f: Filter, ts: string) -> bool {
    if f.since == "" && f.until == "" { return true }
    if ts == "" { return false }
    if f.since != "" && ts < f.since { return false }
    if f.until != "" && ts >= f.until { return false }
    true
}

pub fn matches(f: Filter, r: LogRecord) -> bool {
    if !levelAllowed(f.levels, r.level) { return false }
    if f.service != "" && r.service != f.service { return false }
    if !inWindow(f, r.ts) { return false }
    if f.grep != "" && !contains(toLower(r.msg), toLower(f.grep)) { return false }
    true
}
