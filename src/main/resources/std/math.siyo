import java "java.lang.StrictMath"

pub fn abs(n: int) -> int {
    if n < 0 { return -n }
    return n
}

pub fn min(a: int, b: int) -> int {
    if a < b { return a }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

pub fn pow(base: float, exp: float) -> float {
    return StrictMath.pow(base, exp)
}

pub fn sqrt(n: float) -> float {
    return StrictMath.sqrt(n)
}

pub fn floor(n: float) -> int {
    return toInt(StrictMath.floor(n))
}

pub fn ceil(n: float) -> int {
    return toInt(StrictMath.ceil(n))
}
