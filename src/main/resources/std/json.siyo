import java "codeanalysis.SiyoRuntime"

// A parse either produces an object or says why it could not.
pub type Json = Parsed(map) | Invalid(string)

pub fn parse(text: string) -> Json {
    try {
        Parsed(SiyoRuntime.jsonParseStrict(text))
    } catch e {
        Invalid(e)
    }
}

pub fn parseOrEmpty(text: string) -> map {
    return SiyoRuntime.jsonParse(text)
}

pub fn stringify(v: object) -> string {
    return SiyoRuntime.jsonStringify(v)
}
