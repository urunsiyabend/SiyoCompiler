// Comma-separated values, as RFC 4180 describes them.
//
// A field may be quoted, and a quoted field may hold commas, line breaks and
// quotes written twice. Lines end in CRLF, LF or a lone CR. A byte order mark
// is skipped. Rows are returned as written: one with a different number of
// fields from the next is not a syntax error, so the caller decides what it is.

// A row and the line it starts on, which a quoted line break makes differ from
// its position among the rows.
pub struct CsvRow { line: int, cells: Array<string> }

pub type CsvResult = Table(Array<CsvRow>) | BadCsv(string)

pub fn parse(text: string) -> CsvResult {
    imut n = len(text)
    mut rows: Array<CsvRow> = []
    mut row: Array<string> = []
    mut i = 0
    mut line = 1
    mut rowLine = 1
    if n > 0 && substring(text, 0, 1) == chr(65279) { i = 1 }
    if i >= n { return Table(rows) }
    while true {
        mut value = ""
        if substring(text, i, i + 1) == "\"" {
            imut opened = line
            i += 1
            mut start = i
            mut closed = false
            while i < n && !closed {
                imut c = substring(text, i, i + 1)
                if c == "\"" {
                    value = value + substring(text, start, i)
                    if i + 1 < n && substring(text, i + 1, i + 2) == "\"" {
                        value = value + "\""
                        i += 2
                        start = i
                    } else {
                        i += 1
                        closed = true
                    }
                } else {
                    if c == "\n" || (c == "\r" && !(i + 1 < n && substring(text, i + 1, i + 2) == "\n")) {
                        line += 1
                    }
                    i += 1
                }
            }
            if !closed {
                return BadCsv("line " + toString(opened) + ": a quoted field is not closed")
            }
            if i < n {
                imut after = substring(text, i, i + 1)
                if after != "," && after != "\n" && after != "\r" {
                    return BadCsv("line " + toString(line) + ": text after the closing quote of a field")
                }
            }
        } else {
            imut start = i
            while i < n {
                imut c = substring(text, i, i + 1)
                if c == "," || c == "\n" || c == "\r" { break }
                if c == "\"" {
                    return BadCsv("line " + toString(line) + ": a quote inside an unquoted field")
                }
                i += 1
            }
            value = substring(text, start, i)
        }
        push(row, value)
        if i >= n {
            push(rows, CsvRow { line: rowLine, cells: row })
            break
        }
        imut c = substring(text, i, i + 1)
        if c == "," {
            i += 1
            if i >= n {
                // A comma ending the text leaves one more, empty, field.
                push(row, "")
                push(rows, CsvRow { line: rowLine, cells: row })
                break
            }
            continue
        }
        if c == "\r" && i + 1 < n && substring(text, i + 1, i + 2) == "\n" { i += 2 } else { i += 1 }
        line += 1
        push(rows, CsvRow { line: rowLine, cells: row })
        row = []
        rowLine = line
        if i >= n { break }
    }
    Table(rows)
}

// One row written as a line, without its line ending. A cell is quoted when it
// holds a comma, a quote, a line break, or space at either end.
pub fn formatRow(cells: Array<string>) -> string {
    mut out = ""
    mut first = true
    for cell in cells {
        if !first { out = out + "," }
        first = false
        out = out + quote(cell)
    }
    out
}

fn quote(cell: string) -> string {
    imut needs = contains(cell, ",") || contains(cell, "\"") || contains(cell, "\n") || contains(cell, "\r")
        || (len(cell) > 0 && (startsWith(cell, " ") || endsWith(cell, " ") || startsWith(cell, "\t") || endsWith(cell, "\t")))
    if !needs { return cell }
    "\"" + replace(cell, "\"", "\"\"") + "\""
}
